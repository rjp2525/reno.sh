APP_NAME="Reno Philibert"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Comma separated list of emails allowed into /admin and allowed to mint API tokens.
ADMIN_EMAILS=reno@reno.sh

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Docker (compose.yml) -------------------------------------------------
APP_PORT=8088
VITE_PORT=5188
FORWARD_DB_PORT=54320
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026
TUI_SSH_PORT=2222
WWWUSER=501
WWWGROUP=20

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=reno
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_DRIVER=local
PHOTO_ORIGINALS_DRIVER=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@reno.sh"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Print shop (Stripe Checkout + Prodigi fulfilment) --------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PRODIGI_API_KEY=
# sandbox | live
PRODIGI_ENVIRONMENT=sandbox
PRODIGI_WEBHOOK_SECRET=
PRINTS_CURRENCY=USD

# --- Social publishing ----------------------------------------------------
# Callback for every provider: ${APP_URL}/admin/social/callback/{provider}
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Bluesky and Mastodon use per-account credentials entered in the admin.

# --- Terminal site --------------------------------------------------------
TUI_SSH_HOST=reno.sh
