{
    "name": "rjp2525/reno.sh",
    "type": "project",
    "description": "Personal site of Reno Philibert: portfolio, blog, photography prints and social publishing",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.11",
        "filament/spatie-laravel-tags-plugin": "^5.11",
        "inertiajs/inertia-laravel": "^3.7",
        "intervention/image": "^4.4",
        "laravel/ai": "1.4.0",
        "laravel/framework": "^13.40",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.1",
        "laravel/wayfinder": "^0.1.23",
        "league/flysystem-aws-s3-v3": "^3.30",
        "resend/resend-laravel": "^1.7",
        "spatie/laravel-feed": "^4.5",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/laravel-tags": "^4.12",
        "stripe/stripe-php": "^22.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.14",
        "laravel/pail": "^1.3",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.70",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@age:check"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "age:check": "@php scripts/composer-age-gate.php check",
        "age:update": "@php scripts/composer-age-gate.php update",
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "vendor/bin/pint",
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
